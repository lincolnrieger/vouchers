// Cloudflare Worker configuration for the Woodhouse Voucher Desk.
// Cloudflare reads this on every deploy (Workers Builds runs
// `npx wrangler deploy` after each push to the production branch).
{
  "name": "vouchers",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",

  // The app itself is static files: the page, the two voucher designs and
  // their PDF templates. run_worker_first sends every request through the
  // password check in src/index.js before any file is served.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Limits password attempts per visitor address (10 a minute).
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // The password is the ACCESS_PASSWORD secret, set in the dashboard.
  // keep_vars stops a deploy from touching dashboard variables.
  "keep_vars": true,

  "observability": { "enabled": true }
}
